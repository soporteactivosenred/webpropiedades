# ===============================================
# Propiedades Merino - Environment Variables
# ===============================================
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local to version control

# ===============================================
# Supabase (Required)
# ===============================================
# Get these from your Supabase project dashboard
# Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only (for admin operations)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ===============================================
# Site Configuration
# ===============================================
NEXT_PUBLIC_SITE_URL=https://propiedadesmerino.cl
NEXT_PUBLIC_SITE_NAME=Propiedades Merino

# ===============================================
# Contact Information (for SEO and meta tags)
# ===============================================
NEXT_PUBLIC_CONTACT_EMAIL=contacto@propiedadesmerino.cl
NEXT_PUBLIC_CONTACT_PHONE=+56912345678
NEXT_PUBLIC_CONTACT_WHATSAPP=56912345678
NEXT_PUBLIC_CONTACT_ADDRESS=Av. Principal 1234, Santiago, Chile

# ===============================================
# Social Media Links
# ===============================================
NEXT_PUBLIC_SOCIAL_FACEBOOK=https://facebook.com/propiedadesmerino
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://instagram.com/propiedadesmerino
NEXT_PUBLIC_SOCIAL_LINKEDIN=https://linkedin.com/company/propiedadesmerino

# ===============================================
# Email (Optional - for contact form)
# ===============================================
# If using Resend for email notifications
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=noreply@propiedadesmerino.cl

# ===============================================
# Analytics (Optional)
# ===============================================
# Google Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Tag Manager
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ===============================================
# Development
# ===============================================
NODE_ENV=development

# Skip ISR revalidation for faster development
NEXT_DISABLE_SWR=true